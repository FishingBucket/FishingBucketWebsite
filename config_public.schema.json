{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "api_url": {
            "type": "string",
            "format": "uri",
            "description": "The domain that the FishingBucket API is hosted on."
        },
        "name": {
            "type": "string",
            "description": "The name of the FishingBucket instance."
        },
        "fluxer": {
            "type": "object",
            "properties": {
                "invite": {
                    "type": "string",
                    "format": "uri",
                    "description": "The bot invite URL."
                },
                "guild": {
                    "type": "string",
                    "format": "uri",
                    "description": "The invite link for the support community."
                }
            },
            "required": [
                "invite",
                "guild"
            ],
            "additionalProperties": false,
            "description": "Information related to the Fluxer bot."
        },
        "discord": {
            "description": "Information related to the Discord bot.",
            "type": "object",
            "properties": {
                "invite": {
                    "type": "string",
                    "format": "uri",
                    "description": "The bot invite URL."
                },
                "guild": {
                    "type": "string",
                    "format": "uri",
                    "description": "The invite link for the support community."
                }
            },
            "required": [
                "invite",
                "guild"
            ],
            "additionalProperties": false
        },
        "github": {
            "type": "string",
            "format": "uri",
            "description": "The source code repository of the FishingBucket bot."
        }
    },
    "required": [
        "api_url",
        "name",
        "fluxer",
        "github"
    ],
    "additionalProperties": false
}